# Copie para .env e preencha. NUNCA commite o .env.
PORT=4000
# Supabase > Project Settings > Database > Connection string (URI), modo "Transaction pooler" (porta 6543)
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-isto
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:5173

# Limites da conexão (milissegundos). Falhas não repetem SQL automaticamente.
DB_QUERY_TIMEOUT_MS=8000
DB_POOL_MAX=5
